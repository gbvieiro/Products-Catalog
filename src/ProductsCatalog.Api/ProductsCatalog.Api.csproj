<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f4039c14-555e-4ccd-8499-e1fcf290f096</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Api (composition root) referencia Application e Infrastructure, e monta tudo em Program.cs. -->
    <ProjectReference Include="..\ProductsCatalog.Application\ProductsCatalog.Application.csproj" />
    <ProjectReference Include="..\ProductsCatalog.Infrastructure\ProductsCatalog.Infrastructure.csproj" />
  </ItemGroup>

</Project>
